{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "api/**/*.js", "server.js", "public/**/*.js"],
  "exclude": ["node_modules"]
}
